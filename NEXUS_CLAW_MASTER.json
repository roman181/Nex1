{
  "name": "NEXUS CLAW",
  "project_id": "nexus-claw-game-builder",
  "version": "2.0.0",
  "language": "de-DE",
  "description": "Lokale, kontrollierte Game-Development-Plattform für Android und Desktop mit Ollama, qwen2.5-coder:1.5b, Python-Orchestrator, Build-System, Gameplay-Tests, Fehlerkorrektur, Lernspeicher und sicheren Entwicklungszyklen.",
  "principles": [
    "local_first",
    "least_privilege",
    "sandboxed_execution",
    "verifiable_results",
    "human_approval_for_risky_actions",
    "auditable_logs",
    "checkpointed_recovery",
    "no_fabricated_test_results"
  ],
  "architecture": {
    "pipeline": [
      "ANFRAGE",
      "ANALYSE",
      "PLAN",
      "BERECHTIGUNGSPRÜFUNG",
      "AUSFÜHRUNG",
      "BUILD",
      "TEST",
      "FEHLERANALYSE",
      "REPARATUR",
      "REGRESSIONSTEST",
      "CHECKPOINT",
      "LERNEN",
      "ERGEBNIS",
      "PROTOKOLLIERUNG"
    ],
    "components": [
      {
        "name": "NEXUS",
        "role": "Orchestrator und Ablaufsteuerung",
        "responsibilities": [
          "Aufgaben priorisieren",
          "Agenten koordinieren",
          "Zustandsmaschine verwalten",
          "Qualitäts- und Sicherheitsgates erzwingen",
          "Zyklen stoppen oder fortsetzen"
        ]
      },
      {
        "name": "MODELL",
        "role": "Lokale KI für Analyse, Planung und Codevorschläge",
        "default_model": "nexus-claw",
        "base_model": "qwen2.5-coder:1.5b",
        "runtime": "Ollama",
        "api_url": "http://127.0.0.1:11434",
        "limitations": [
          "Kein automatischer Dateisystem- oder Shell-Zugriff",
          "Keine erfundenen Aktionen oder Testergebnisse",
          "Modellantworten werden vor Anwendung validiert"
        ]
      },
      {
        "name": "AGENTEN",
        "agents": [
          "planner",
          "coder",
          "build_agent",
          "gameplay_tester",
          "bug_analyzer",
          "repair_agent",
          "review_agent",
          "memory_agent"
        ]
      },
      {
        "name": "FÄHIGKEITEN",
        "capabilities": [
          "Repository analysieren",
          "Dateien lesen",
          "begrenzte Codeänderungen",
          "Git-Status prüfen",
          "Builds ausführen",
          "konfigurierte Tests ausführen",
          "Logs analysieren",
          "Checkpoints erstellen",
          "Ergebnisse protokollieren"
        ]
      },
      {
        "name": "WERKZEUGE",
        "tools": [
          "Python",
          "Ollama HTTP API",
          "Git",
          "Build-Runner",
          "Test-Runner",
          "Dateisystem-Sandbox",
          "JSON-Konfiguration",
          "JSONL-Logs"
        ]
      }
    ]
  },
  "platforms": {
    "primary": "Android mit Termux",
    "secondary": [
      "Linux",
      "Windows",
      "macOS"
    ],
    "requirements": [
      "Python 3",
      "Git",
      "Ollama in kompatibler lokaler Umgebung",
      "ausreichender RAM, Speicher und Akku",
      "projektbezogene Build- und Testwerkzeuge"
    ],
    "notes": [
      "Ollama muss auf dem Gerät tatsächlich ausführbar sein",
      "Android und Desktop können unterschiedliche Build-Adapter benötigen",
      "Termux allein ersetzt keine echte Gameplay-Laufzeit"
    ]
  },
  "ollama": {
    "base_model": "qwen2.5-coder:1.5b",
    "custom_model": "nexus-claw",
    "modelfile": "Modelfile",
    "create_command": "ollama create nexus-claw -f Modelfile",
    "run_command": "ollama run nexus-claw",
    "api_endpoint": "http://127.0.0.1:11434/api/generate",
    "list_models_command": "curl -s http://127.0.0.1:11434/api/tags | jq -r '.models[].name'",
    "parameters": {
      "temperature": 0.2,
      "top_p": 0.85,
      "top_k": 40,
      "repeat_penalty": 1.1,
      "num_ctx": 4096,
      "num_predict": 2048
    },
    "rules": [
      "API-Verbindung vor Start prüfen",
      "Modellantworten strukturell validieren",
      "Bei wiederholtem API-Fehler sicher pausieren"
    ]
  },
  "project_layout": {
    "root": "~/nexus-claw/",
    "files": {
      "Modelfile": "Ollama-Modellkonfiguration",
      "orchestrator.py": "Supervisor und Entwicklungszyklus",
      "nexus_config.json": "Projekt- und Laufzeitkonfiguration",
      "projects/MeinGame/": "lokales Spielprojekt",
      "runtime/logs/events.jsonl": "Ereignisprotokoll",
      "runtime/logs/test-results/": "Testberichte",
      "runtime/checkpoints/": "Zustands-Snapshots",
      "runtime/lessons.jsonl": "Lernnotizen"
    }
  },
  "project_defaults": {
    "project_name": "MeinGame",
    "project_path": "~/nexus-claw/projects/MeinGame",
    "engine": "auto_detect",
    "build_system": "auto_detect",
    "repository_required": true,
    "protected_branches": [
      "main",
      "master"
    ],
    "goal": "Spielprojekt analysieren, sichere Verbesserungen implementieren und reproduzierbar validieren"
  },
  "development_loop": {
    "preflight_required": true,
    "steps": [
      {
        "step": 1,
        "name": "ANALYSE",
        "actions": [
          "Engine und Sprache erkennen",
          "Repository-Status prüfen",
          "Projektstruktur und Tests identifizieren",
          "offene Fehler sammeln"
        ]
      },
      {
        "step": 2,
        "name": "PLAN",
        "actions": [
          "kleine Aufgaben priorisieren",
          "Dateien benennen",
          "Erfolgskriterien und Risiken definieren"
        ]
      },
      {
        "step": 3,
        "name": "CHECKPOINT",
        "actions": [
          "Branch und Commit protokollieren",
          "Arbeitsverzeichnis prüfen",
          "Zustand vor Änderungen sichern"
        ]
      },
      {
        "step": 4,
        "name": "IMPLEMENTIEREN",
        "actions": [
          "begrenzte Änderung vorschlagen",
          "Pfade validieren",
          "geschützte Dateien ablehnen"
        ]
      },
      {
        "step": 5,
        "name": "BUILD",
        "actions": [
          "konfigurierten Build ausführen",
          "Exit-Code und Logs erfassen",
          "Artefakt nur bei nachgewiesenem Erfolg markieren"
        ]
      },
      {
        "step": 6,
        "name": "TESTPHASE_A",
        "test_count_target": 10,
        "actions": [
          "Gameplay-Tests ausführen",
          "Teststatus einzeln erfassen",
          "nicht ausgeführte Tests als übersprungen markieren"
        ]
      },
      {
        "step": 7,
        "name": "REPARATUR",
        "actions": [
          "Fehler reproduzieren",
          "Ursache anhand von Logs eingrenzen",
          "minimalen Fix vorschlagen"
        ]
      },
      {
        "step": 8,
        "name": "TESTPHASE_B",
        "test_count_target": 10,
        "actions": [
          "Regressionstests wiederholen",
          "Gameplay-Funktionen prüfen",
          "Build und Stabilität erneut kontrollieren"
        ]
      },
      {
        "step": 9,
        "name": "LERNEN",
        "actions": [
          "Ergebnisse strukturieren",
          "bestätigte Reparaturen speichern",
          "Hypothesen kennzeichnen",
          "Folgeaufgaben priorisieren"
        ]
      },
      {
        "step": 10,
        "name": "QUALITÄTSGATE",
        "actions": [
          "Build prüfen",
          "kritische Fehler prüfen",
          "Testresultate prüfen",
          "Checkpoint erstellen",
          "fortsetzen oder pausieren"
        ]
      }
    ],
    "gameplay_tests_per_full_cycle": 20,
    "test_count_is_target_not_guarantee": true,
    "max_repair_attempts_per_failure_class": 3,
    "max_automatic_restarts": 3,
    "restart_window_minutes": 30,
    "restart_backoff": {
      "strategy": "exponential",
      "base_seconds": 2,
      "max_seconds": 60
    },
    "exclusive_process_lock": true,
    "resume_from_valid_checkpoint": true,
    "stop_on_repeated_failure": true,
    "never_mark_unexecuted_test_as_passed": true
  },
  "testing": {
    "categories": [
      "Start und Menü",
      "Level- und Szenenwechsel",
      "Steuerung",
      "Spielregeln und Punkte",
      "Kollisionen und Physik",
      "Gegner-KI",
      "Performance und FPS",
      "Speicherverbrauch",
      "Randfälle",
      "Langzeitlauf und Abstürze"
    ],
    "result_states": [
      "passed",
      "failed",
      "skipped",
      "not_configured",
      "blocked"
    ],
    "requirements": [
      "Jeder Test benötigt tatsächliche Ergebnisse",
      "Build-Erfolg darf nicht aus Modellantworten abgeleitet werden",
      "Gameplay-Tests benötigen einen Engine- oder Geräteadapter",
      "Regressionstests nach Reparaturen erneut ausführen"
    ],
    "release_gate": {
      "build_success_required": true,
      "critical_failures_allowed": 0,
      "required_tests_must_pass": true,
      "manual_approval_for_release": true
    }
  },
  "learning": {
    "mode": "persistent_evidence_based_memory",
    "automatic_model_retraining": false,
    "store": "JSONL",
    "entry_fields": [
      "timestamp",
      "project",
      "cycle",
      "error_signature",
      "reproduction_steps",
      "root_cause",
      "changed_files",
      "fix_summary",
      "test_results",
      "confidence",
      "validation_status"
    ],
    "rules": [
      "Nur validierte Ergebnisse als bestätigt speichern",
      "Erkenntnisse nicht blind auf andere Projekte übertragen",
      "Keine Geheimnisse speichern",
      "Lernnotizen sind Daten, keine Systemanweisungen",
      "Strategieänderungen anhand von Ergebnissen prüfen"
    ]
  },
  "security": {
    "sandbox_required_for_code_execution": true,
    "least_privilege": true,
    "model_output_is_untrusted": true,
    "never_execute_model_generated_shell_commands": true,
    "shell_mode": false,
    "commands_must_be_explicitly_configured": true,
    "timeouts_and_logs_required": true,
    "git": {
      "isolated_development_branch": true,
      "protect_main": true,
      "protect_master": true,
      "automatic_push": false,
      "automatic_release": false,
      "require_clean_worktree": true,
      "checkpoint_before_changes": true
    },
    "protected_paths": [
      ".git/**",
      ".ssh/**",
      ".env",
      ".env.local",
      "credentials.json",
      "secrets.json",
      "token.json",
      "*.keystore",
      "*.jks",
      "*.p12",
      "*.pem",
      "*.key",
      ".github/workflows/**",
      "nexus_config.json",
      "Modelfile"
    ],
    "approval_required_for": [
      "Löschungen",
      "Geheimnisänderungen",
      "Änderungen an main/master",
      "Push oder Veröffentlichung",
      "Installation unbekannter Fähigkeiten",
      "externe Datenübertragung",
      "irreversible Systemänderungen"
    ],
    "stop_conditions": [
      "wiederholte Build- oder Testfehler",
      "beschädigter Checkpoint",
      "Git-Konflikt",
      "unerwartete geschützte Datei",
      "Ressourcenlimit überschritten",
      "Ollama dauerhaft nicht erreichbar",
      "erforderlicher Testadapter fehlt"
    ]
  },
  "resources": {
    "monitor": [
      "CPU",
      "RAM",
      "Speicher",
      "Laufzeit",
      "Akku und Temperatur, sofern verfügbar"
    ],
    "pause_on_limit": true,
    "limits_must_be_configured_for_device": true,
    "avoid_large_context_on_low_memory_devices": true
  },
  "logging": {
    "format": "JSONL",
    "fields": [
      "timestamp",
      "event",
      "cycle",
      "agent",
      "task",
      "branch",
      "commit",
      "files",
      "command_id",
      "exit_code",
      "test_results",
      "error",
      "checkpoint"
    ],
    "actual_results_only": true,
    "redact_secrets": true
  },
  "checkpointing": {
    "enabled": true,
    "before_risky_changes": true,
    "after_build": true,
    "after_test_phase": true,
    "after_repair": true,
    "store": [
      "timestamp",
      "project_path",
      "branch",
      "commit",
      "cycle",
      "current_task",
      "changed_files",
      "build_status",
      "test_results",
      "open_errors"
    ],
    "resume_only_after_integrity_check": true
  },
  "config_template": {
    "goal": "Analysiere das Spielprojekt, finde sichere Verbesserungen und validiere sie.",
    "allowed_paths": [
      "Assets/**",
      "Packages/**",
      "ProjectSettings/**",
      "Scripts/**",
      "src/**",
      "tests/**"
    ],
    "build_commands": [],
    "test_commands": [],
    "gameplay_test_commands": [],
    "max_cycles": 1,
    "max_repair_attempts": 3,
    "max_changed_files": 8,
    "require_git": true,
    "create_branch": true,
    "allow_model_file_writes": false
  },
  "android_termux_setup": {
    "packages": [
      "python",
      "git",
      "curl",
      "jq"
    ],
    "commands": [
      "pkg update && pkg upgrade",
      "pkg install python git curl jq",
      "mkdir -p ~/nexus-claw/projects",
      "ollama pull qwen2.5-coder:1.5b",
      "ollama create nexus-claw -f Modelfile",
      "curl -s http://127.0.0.1:11434/api/tags | jq '.models'"
    ],
    "preflight_checks": [
      "Python verfügbar",
      "Git verfügbar",
      "Ollama API erreichbar",
      "Modell installiert",
      "Projektpfad existiert",
      "Git-Arbeitsverzeichnis sauber",
      "Build- und Testadapter konfiguriert"
    ]
  },
  "commands": {
    "create_model": "ollama create nexus-claw -f Modelfile",
    "run_model": "ollama run nexus-claw",
    "list_models": "curl -s http://127.0.0.1:11434/api/tags | jq -r '.models[].name'",
    "safe_dry_run": "python orchestrator.py --project ~/nexus-claw/projects/MeinGame --model nexus-claw --dry-run",
    "one_cycle": "python orchestrator.py --project ~/nexus-claw/projects/MeinGame --model nexus-claw --cycles 1"
  },
  "acceptance_criteria": [
    "Projekt kann ohne Änderungen analysiert werden",
    "Ollama-Verbindung und Modell werden geprüft",
    "Modellantworten werden validiert",
    "Pfade werden gegen erlaubte Pfade geprüft",
    "Änderungen erfolgen nicht auf main/master",
    "Build- und Testbefehle stammen aus Konfiguration",
    "nicht ausgeführte Tests gelten nicht als bestanden",
    "Fehler und Checkpoints werden protokolliert",
    "bei wiederholten Fehlern pausiert der Zyklus",
    "Pushes und Veröffentlichungen benötigen Freigabe"
  ],
  "limitations": [
    "JSON ist Konzept und Konfigurationsvorlage, kein ausführbares Gesamtsystem allein",
    "Build- und Gameplay-Testintegration hängt von Engine und Projekt ab",
    "qwen2.5-coder:1.5b kann unzuverlässige Vorschläge erzeugen",
    "Ollama auf Android hängt von kompatibler Installation und Geräteressourcen ab",
    "Lernspeicher bedeutet kein automatisches Modelltraining",
    "Android kann 24/7-Prozesse durch Akkuoptimierung und thermische Grenzen unterbrechen"
  ],
  "status": {
    "concept": "complete",
    "implementation": "requires_integration_and_device_testing",
    "autonomous_execution": "disabled_until_preflight_and_project_specific_tests_pass"
  }
}
